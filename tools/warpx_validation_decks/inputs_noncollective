# Uniform, stationary, Maxwellian hydrogen plasma in 1D.
# The point is that the answer is known: n_e, T_e and T_i are set here, so the
# Thomson spectrum recovered from the macroparticles can be compared against
# thomson.spectral_density evaluated at the same numbers.

my_constants.ne     = 1.000000e+24          # m^-3
my_constants.uth_e  = 3.128059e-02   # sqrt(k Te / me) / c, Te = 500 eV
my_constants.uth_i  = 3.264642e-04   # sqrt(k Ti / mi) / c, Ti = 100 eV

#################################
############ NUMERICS ###########
#################################
max_step             = 700
amr.n_cell           = 256
amr.max_level        = 0
amr.blocking_factor  = 8
geometry.dims        = 1
geometry.prob_lo     = 0.
geometry.prob_hi     = 2.560000e-05   # 256 cells x 100 nm; dz/lambda_De = 0.60
warpx.cfl            = 0.5
warpx.verbose        = 1
warpx.random_seed    = 1
algo.particle_shape  = 3

boundary.field_lo    = periodic
boundary.field_hi    = periodic
boundary.particle_lo = periodic
boundary.particle_hi = periodic

#################################
########### PARTICLES ###########
#################################
particles.species_names = electrons ions

electrons.species_type       = electron
electrons.injection_style    = "NUniformPerCell"
electrons.num_particles_per_cell_each_dim = 10000
electrons.profile            = constant
electrons.density            = ne
electrons.momentum_distribution_type = maxwellian
electrons.maxwellian_u_std_distribution_type = "constant"
electrons.ux_std = uth_e
electrons.uy_std = uth_e
electrons.uz_std = uth_e

ions.species_type            = proton
ions.injection_style         = "NUniformPerCell"
ions.num_particles_per_cell_each_dim = 10000
ions.profile                 = constant
ions.density                 = ne
ions.momentum_distribution_type = maxwellian
ions.maxwellian_u_std_distribution_type = "constant"
ions.ux_std = uth_i
ions.uy_std = uth_i
ions.uz_std = uth_i

#################################
########## DIAGNOSTICS ##########
#################################
diagnostics.diags_names = diag1

diag1.intervals      = 350
diag1.diag_type      = Full
diag1.format         = plotfile
diag1.fields_to_plot = rho rho_electrons rho_ions
diag1.write_species  = 1
diag1.species        = electrons ions
